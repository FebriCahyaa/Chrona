name: CodeQL

on:
  push:
    branches: ["main", "master", "develop"]
  pull_request:
  schedule:
    - cron: '31 2 * * 1'
  workflow_dispatch:

permissions:
  contents: read
  security-events: write
  actions: read

concurrency:
  group: codeql-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  analyze:
    name: Analyze Android sources
    runs-on: ubuntu-latest
    timeout-minutes: 40
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Set up JDK 17
        uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: '17'
          cache: gradle

      - name: Set up Android SDK
        uses: android-actions/setup-android@v4
        with:
          packages: 'platform-tools platforms;android-37 build-tools;36.0.0 cmake;3.31.6 ndk;30.0.16248370'

      - name: Initialize CodeQL
        uses: github/codeql-action/init@v4
        with:
          languages: java, c-cpp
          build-mode: manual

      - name: Build for CodeQL extraction
        run: |
          chmod +x ./gradlew
          ./gradlew --no-daemon assembleDebug --stacktrace

      - name: Analyze
        uses: github/codeql-action/analyze@v4
        with:
          category: /languages:java-cpp
