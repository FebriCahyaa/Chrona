diff --git a/app/src/main/java/com/febricahyaa/clockapp/navigation/ChronaNavigationActions.kt b/app/src/main/java/com/febricahyaa/clockapp/navigation/ChronaNavigationActions.kt
index 7522d2e..cedc193 100644
--- a/app/src/main/java/com/febricahyaa/clockapp/navigation/ChronaNavigationActions.kt
+++ b/app/src/main/java/com/febricahyaa/clockapp/navigation/ChronaNavigationActions.kt
@@ -9,7 +9,17 @@ class ChronaNavigationActions(
 ) {
 
     fun navigate(destination: AppDestination) {
+        if (destination == AppDestination.CLOCK) {
+            navController.popBackStack(ChronaRoutes.CLOCK, inclusive = false)
+            return
+        }
+
         navController.navigate(destination.route()) {
+            if (ChronaNavigationPolicy.isPrimaryTimeTool(destination)) {
+                popUpTo(ChronaRoutes.CLOCK) {
+                    saveState = true
+                }
+            }
             launchSingleTop = true
             restoreState = true
         }
@@ -37,3 +47,13 @@ class ChronaNavigationActions(
 
     fun back(): Boolean = navController.popBackStack()
 }
+
+internal object ChronaNavigationPolicy {
+    fun isPrimaryTimeTool(destination: AppDestination): Boolean = when (destination) {
+        AppDestination.ALARM,
+        AppDestination.WORLD,
+        AppDestination.TIMER,
+        AppDestination.STOPWATCH -> true
+        else -> false
+    }
+}
diff --git a/app/src/test/java/com/febricahyaa/clockapp/navigation/ChronaNavigationStackPolicyTest.kt b/app/src/test/java/com/febricahyaa/clockapp/navigation/ChronaNavigationStackPolicyTest.kt
