<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device-transfer rules: alarms and settings. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="alarms.db" />
        <include domain="sharedpref" path="com.febricahyaa.chrona_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="alarms.db" />
        <include domain="sharedpref" path="com.febricahyaa.chrona_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
