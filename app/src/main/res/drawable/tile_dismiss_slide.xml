<?xml version="1.0" encoding="utf-8"?>
<!-- "Slide" tile in the dismiss-style dialog: a pill with a handle in the middle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="80dp" android:height="24dp" android:gravity="top|start"
        android:left="8dp" android:top="36dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="?attr/colorSurface" />
        </shape>
    </item>
    <item android:width="32dp" android:height="24dp" android:gravity="top|start"
        android:left="32dp" android:top="36dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="?attr/colorPrimary" />
        </shape>
    </item>
</layer-list>
