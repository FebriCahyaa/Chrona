<!--
  ic_chrona_background.xml
  Adaptive Icon — Background Layer (108x108dp canvas)
  Gradient diagonal minimalis: indigo gelap → ungu vivid.
  Layer ini statis (tidak ikut ditint oleh Dynamic Color / Monochrome system,
  hanya foreground+monochrome yang diproses saat Themed Icon Android 13+ aktif).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#1C1B2E"
                android:centerColor="#332B5C"
                android:endColor="#5B4BDB" />
        </aapt:attr>
    </path>

    <!-- Vignette halus di sudut agar background tidak terasa flat -->
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#14000000" />

</vector>