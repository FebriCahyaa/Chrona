<!-- Quick presets (1, 5, 10, 15 minutes) and the wide start button. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/timer_setup_preset_1"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/timer_setup_preset_height"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/timer_setup_preset_1"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/timer_setup_preset_5"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/timer_setup_preset_height"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/timer_setup_preset_5"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/timer_setup_preset_10"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/timer_setup_preset_height"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/timer_setup_preset_10"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/timer_setup_preset_15"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/timer_setup_preset_height"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:text="@string/timer_setup_preset_15"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/timer_setup_start"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/timer_setup_start_height"
        android:layout_marginTop="12dp"
        android:text="@string/timer_start"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

</LinearLayout>
